# Supabase — enquiry form + /admin panel.
# Supabase dashboard -> Project Settings -> API.
# These are PUBLIC keys (safe in the browser). Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# New key format (sb_publishable_...). The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Public site URL (used for sitemap.xml and robots.txt). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.kohpeaks.com

# Optional: only needed if you use Drizzle migrations (npm run db:*).
DATABASE_URL=
